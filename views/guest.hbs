<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="stylesheet" href="/style.css">
    <title>Cut & Hustle</title>
</head>
<body>
    <nav class="navbar">
        <ul class="nav-list">
            <li class="nav-item nav-logo">Cuts & Hustle</li>
            <li class="nav-item"><a href="#home" class="nav-link">Home</a></li>
            <li class="nav-item"><a href="#services" class="nav-link">Services</a></li>
            <li class="nav-item"><a href="#team" class="nav-link">Our Team</a></li>
            <li class="nav-item"><a href="#booking" class="nav-link">Book Now</a></li>
            <li class="nav-item"><a href="#contact" class="nav-link">Contact</a></li>
            <li class="nav-item"><a href="/login/register" class="nav-link">Register</a></li>
        </ul>
    </nav>
    
    <!--Hero section-->
    <section id="home" class="hero-section fade-in">
        <h1 class="hero-title">Precision Cuts & Classic Styles</h1>
        <p class="lead-text">Experience the art of traditional barbering with modern techniques. Our skilled barbers are dedicated to giving you the perfect look.</p>
    </section>

    <!--Services-->
<section id="services" class="services-section fade-in">
    <h2 class="section-title">Our Services</h2>
    <p class="section-intro">We offer a wide range of grooming services for the modern gentleman</p>
    
    <div class="services-grid">
        <div class="service-row">
            {{#each services}}
            <div class="service-column fade-in">
                <div class="service-card">
                    <img src="{{this.pictures}}" alt="{{this.name}}" class="service-image">
                    
                    <div class="card-content">
                        <h3 class="service-title">{{this.name}}</h3>
                        <p class="service-description">{{this.description}}</p> 
                        
                        <p class="service-detail"><strong>Duration: </strong>{{this.duration_minutes}} min</p>
                        
                        <p class="service-detail">
                            <strong>Price:</strong> 
                            <span>${{this.price}}</span>
                        </p>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>

    <!--Team-->
    <section id="team" class="team-section">
    <div class="container">
        <h2 class="section-title fade-in">Our Team</h2>
        <p class="section-intro">Our experienced barbers are masters of their craft</p>
        <div class="team-grid">
            <div class="team-row">
            
            {{#each barbers}}
            <div class="team-column fade-in">
                <a href="/login/works/{{this.id}}">
                <div class="team-card">
                    <img src="{{this.pictures}}" alt="{{this.name}}" class="team-image">
                    
                    <div class="team-content">
                        <h3 class="team-name">{{this.name}}</h3>
                        <p class="team-info"><strong>Experience: </strong>{{this.experience}} years</p>
                        <p class="team-info"><strong>Specialty: </strong>{{this.speciality}}</p>
                    </div>
                </div>
                </a>
            </div>
            {{/each}}
            </div>
        </div>
    </div>
</section>

    <!--Booking-->
    
    <section id="booking" class="booking-section fade-in">
        <h2 class="section-title fade-in" style="color: aliceblue;">Booking</h2><br><br>
        <form class="booking-form" id="bookingForm" action="/auth/booking" method="post">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" name="name" id="name" class="form-input" required>

            <label for="email" class="form-label">Email</label>
            <input type="text" name="email" id="email" class="form-input" required>

            <label for="phone" class="form-label">Phone Number</label>
            <input type="tel" name="phone" id="phone" placeholder="06 20 123 4567" pattern="[0-9]{2}[0-9]{2}[0-9]{3}[0-9]{4}" maxlength="14" class="form-input" required>

            
            
            <label for="service" class="form-label">Select a Service</label>
            <select name="service" id="service" class="form-select" required>
                <option value="" hidden>Select a Service</option>
                {{#each services}}
                <option value="{{this.id}}" data-duration="{{this.duration_minutes}}">{{this.name}} - {{this.price}}$</option>
                {{/each}}
            </select>
            
           <label for="barber" class="form-label">Preferred Barber</label>
            <select name="barber" id="barber" class="form-select" required>
                <option value="" hidden>Select a barber</option>
                {{#each barbers}}
                <option value="{{this.id}}">{{this.name}} - {{this.small_text}}</option>
                {{/each}}
            </select>

            <label for="date" class="form-label">Preferred Date</label>
            <input type="date" id="date" name="date" class="form-input" required>

           <div class="form-group">
            <label for="time">Preferred Time</label>
            <select id="time" name="time" class="form-input" required>
            <option value="" hidden>Select Time</option>
            </select>
            </div>

            <button type="submit" id="button" class="submit-button">Book Now</button>

            {{#if message}}
            <div class="alert alert-{{alertType}} mt-4" role="alert">
            {{message}}
            </div>
            {{/if}}
        </form>
    </section>

    <!--Footer-->
    <footer id="contact" class="main-footer">
        <div class="footer-container">
            <div class="footer-column">
                <h3 class="footer-heading">About Us</h3>
                <p class="footer-text">Classic Cuts has been providing premium grooming services since 2005. We combine traditional techniques with modern styles.</p>
                <div class="social-links">
                    <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
            
            <div class="footer-column">
                <h3 class="footer-heading">Contact Info</h3>
                <p class="footer-text"><i class="fas fa-map-marker-alt footer-icon"></i> 123 Barber Street, Cityville</p>
                <p class="footer-text"><i class="fas fa-phone footer-icon"></i> (555) 123-4567</p>
                <p class="footer-text"><i class="fas fa-envelope footer-icon"></i> info@classiccuts.com</p>
            </div>
            
            <div class="footer-column">
                <h3 class="footer-heading">Opening Hours</h3>
                <p class="footer-text">Monday - Sunday: 9am - 7pm</p>
            </div>
        </div>
        
        <p class="copyright">© 2026 Cuts & Hustle Barber Shop. All rights reserved.</p>
    </footer>

<script src="/main_page.js"></script>
<script src="/appointments.js"></script>
</body>
</html>